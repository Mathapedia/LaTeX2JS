{
  "name": "@latex2js/macros",
  "version": "3.1.0",
  "description": "latex2js macros",
  "author": "Dan Lynch <pyramation@gmail.com>",
  "homepage": "https://github.com/Mathapedia/LaTeX2JS",
  "license": "SEE LICENSE IN LICENSE",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mathapedia/LaTeX2JS"
  },
  "keywords": [
    "latex",
    "latex2html",
    "latex2js",
    "math",
    "mathematics",
    "mathjax"
  ],
  "scripts": {
    "clean": "makage clean",
    "prepack": "pnpm run build && makage check-publish",
    "build": "makage clean && makage build-ts && makage assets",
    "build:dev": "makage clean && makage build-ts --dev && makage assets",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand"
  },
  "devDependencies": {
    "makage": "^0.6.0"
  },
  "bugs": {
    "url": "https://github.com/Mathapedia/LaTeX2JS/issues"
  }
}
